                "fixable": false,
                "severity": "error"
              },
              "shortDescription": {
                "text": "a setf/setq/psetf/psetq that assigns the same variable more than once ((setf a 1 a 2))"
              }
            },
            {
              "id": "setf-arity",
              "properties": {
                "category": "arity",
                "fixable": false,
                "severity": "error"
              },
              "shortDescription": {
