    },
    {
      "category": "dead-code",
      "count": 1,
      "description": "an and/or whose non-final constant operand makes later operands dead",
      "rule": "dead-boolean-operand"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an and/or with a redundant identity operand (t in and, nil in or; (and a t b) is (and a b))",
      "rule": "redundant-boolean-identity"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an and/or of all negations, collapsible by De Morgan ((and (not a) (not b)) is (not (or a b)))",
      "rule": "de-morgan"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a single-operand and/or ((and X) and (or X) are just X)",
      "rule": "single-operand-boolean"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a single-argument append/nconc/list*, which returns its argument unchanged ((append x) is x)",
      "rule": "single-operand-list-op"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a single-operand +/* ((+ X) and (* X) are just X)",
      "rule": "single-operand-arithmetic"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an eq/eql compared against a string literal (never reliably eql)",
      "rule": "eql-string-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an eq/eql compared against a quoted list literal (never reliably eql)",
      "rule": "eql-list-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a member/assoc/find/substitute/adjoin/... searching for a string/list literal without :test (default eql won't match)",
      "rule": "eql-search-literal"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an eq compared against a number literal (eq on numbers is unreliable)",
      "rule": "eq-number-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an eq compared against a character literal (eq on characters is unreliable; use eql/char=)",
      "rule": "eq-char-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a numeric comparison (< > <= >= = /=) with one argument (always true; missing an operand?)",
      "rule": "single-arg-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a =/</> comparison against 0 with a dedicated predicate ((= x 0) is (zerop x))",
      "rule": "sign-comparison"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a cond with one non-t clause that has a body ((cond (test a b)) is (when test a b))",
      "rule": "single-clause-cond"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a cond with one t clause that has a body ((cond (t a b)) is (progn a b))",
      "rule": "cond-t-clause"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a multiple-value-bind of one variable ((multiple-value-bind (x) f body) is (let ((x f)) body))",
      "rule": "single-value-bind"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a format call whose first argument is a string literal (nil/t/stream destination is missing)",
      "rule": "format-missing-destination"
    },
    {
      "category": "malformed",
      "count": 1,
      "description": "an incf/decf/push/pop/pushnew/setf/psetf whose place is a self-evaluating literal (cannot be modified)",
      "rule": "literal-place"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a destructive call (nreverse/sort/delete/nsubstitute/nconc/...) on a quoted list literal (undefined behavior)",
      "rule": "destructive-literal"
    },
    {
      "category": "malformed",
      "count": 1,
      "description": "a character function (char=/char-code/alpha-char-p/...) applied to a string literal (type error)",
      "rule": "char-op-string"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a when/unless/dolist/dotimes with no body (the test/spec runs, then nothing happens)",
      "rule": "empty-body"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an arithmetic form with a redundant identity operand ((+ x 0), (* x 1), (- x 0), (/ x 1))",
      "rule": "identity-arithmetic"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "negation written the long way ((- 0 x) and (* x -1) are (- x))",
      "rule": "verbose-negation"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a two-argument list*, which is just a cons ((list* a b) is (cons a b))",
      "rule": "list-star-to-cons"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a values-list of a list constructor ((values-list (list a b)) is (values a b))",
      "rule": "values-list-of-list"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a prog1 wrapping a single form, which is just that form ((prog1 x) is x)",
      "rule": "redundant-prog1"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a subseq from index 0, a whole-sequence copy ((subseq seq 0) is (copy-seq seq))",
      "rule": "subseq-zero"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a car of an nthcdr, which is nth ((car (nthcdr n x)) is (nth n x))",
      "rule": "car-nthcdr"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a car of a reverse, a wasteful full copy ((car (reverse x)) is (car (last x)))",
      "rule": "car-reverse"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a two-argument append with a nil tail, a fresh copy ((append x nil) is (copy-list x))",
      "rule": "append-nil"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a multiple-value-list of a values form ((multiple-value-list (values a b)) is (list a b))",
      "rule": "multiple-value-list-of-values"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a typep against a type with a dedicated predicate ((typep x 'string) is (stringp x))",
      "rule": "typep-predicate"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a coerce to type t, which returns the object unchanged ((coerce x t) is x)",
      "rule": "coerce-to-t"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a gethash with an explicit nil default, the default ((gethash k h nil) is (gethash k h))",
      "rule": "gethash-default"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a make-hash-table with an explicit :test 'eql, the default ((make-hash-table :test 'eql) is (make-hash-table))",
      "rule": "make-hash-table-test"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a division-family form with a literal 0 divisor, a guaranteed division-by-zero ((/ x 0))",
      "rule": "zero-divisor"
    },
    {
      "category": "duplicate",
      "count": 1,
      "description": "a make-* call passing the same keyword argument twice ((make-instance 'c :x 1 :x 2))",
      "rule": "duplicate-keyword"
    },
    {
      "category": "malformed",
      "count": 1,
      "description": "a quoted designator in a defpackage clause, which defpackage does not evaluate ((:export 'foo))",
      "rule": "defpackage-quoted"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "an incf/decf with an explicit step of 0, a no-op ((incf x 0))",
      "rule": "step-zero"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a three-argument if with then=nil ((if c nil e) is (unless c e))",
      "rule": "if-to-unless"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a two-form prog2, which is just progn ((prog2 a b) is (progn a b))",
      "rule": "prog2-to-progn"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a handler-case with no handler clauses, which is just its body ((handler-case x) is x)",
