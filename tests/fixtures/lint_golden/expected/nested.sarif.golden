              "properties": {
                "category": "malformed",
                "fixable": false,
                "severity": "error"
              },
              "shortDescription": {
                "text": "a setq/psetq place that is not a variable (a list, literal, or constant)"
              }
            },
            {
              "id": "manual-incf",
              "properties": {
                "category": "suspicious",
                "fixable": true,
                "severity": "warning"
              },
              "shortDescription": {
                "text": "a setf/setq that manually increments a variable ((setf x (1+ x)) is (incf x))"
              }
            },
            {
              "id": "manual-push",
              "properties": {
                "category": "suspicious",
                "fixable": true,
                "severity": "warning"
              },
              "shortDescription": {
                "text": "a setf/setq that manually conses onto a variable ((setf x (cons e x)) is (push e x))"
              }
            },
            {
              "id": "manual-pushnew",
              "properties": {
                "category": "suspicious",
                "fixable": true,
                "severity": "warning"
              },
              "shortDescription": {
                "text": "a setf/setq that manually adjoins onto a variable ((setf x (adjoin e x)) is (pushnew e x))"
              }
            },
            {
              "id": "explicit-step-delta",
              "properties": {
                "category": "suspicious",
                "fixable": true,
                "severity": "warning"
              },
              "shortDescription": {
                "text": "an incf/decf with an explicit delta of 1, the default ((incf x 1) is (incf x))"
              }
            },
