    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a make-list call with an explicit :initial-element nil, the default ((make-list n :initial-element nil) is (make-list n))",
      "rule": "make-list-default-element"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a parse-integer call with an explicit :radix 10, the default ((parse-integer s :radix 10) is (parse-integer s))",
      "rule": "parse-integer-default-radix"
    },
    {
      "category": "suspicious",
      "count": 1,
