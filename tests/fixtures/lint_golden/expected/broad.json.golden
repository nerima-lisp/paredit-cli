    },
    {
      "category": "performance",
      "count": 0,
      "description": "a (length …) call used only to decide whether a sequence is empty, which walks the whole sequence",
      "rule": "length-emptiness-test"
    },
    {
      "category": "performance",
      "count": 0,
      "description": "a loop that grows a sequence by appending to its own accumulated value, which is quadratic",
      "rule": "quadratic-accumulation"
    },
    {
      "category": "performance",
      "count": 0,
      "description": "a loop that linearly searches the same collection on every round, which is quadratic",
      "rule": "linear-search-in-loop"
    },
    {
      "category": "allocation",
      "count": 0,
      "description": "a copy-seq/copy-list result passed to an operator that only reads it, so the copy is garbage",
      "rule": "unnecessary-copy"
    },
    {
      "category": "allocation",
      "count": 0,
      "description": "a fresh copy fed to a destructive operator, where one non-destructive operator does both",
      "rule": "copy-before-destructive"
    },
    {
      "category": "portability",
      "count": 0,
      "description": "a symbol from an implementation's own package, outside any reader conditional guarding it",
      "rule": "implementation-package-symbol"
    },
    {
      "category": "portability",
      "count": 0,
      "description": "a filesystem call given a string that spells one host's path syntax",
      "rule": "unportable-pathname"
    },
    {
      "category": "portability",
      "count": 0,
      "description": "a (code-char N) call with a literal code, which assumes ASCII and hides which character it means",
      "rule": "ascii-code-char"
    },
    {
      "category": "numeric-precision",
      "count": 0,
      "description": "an exact equality test against a float literal, whose result depends on rounding upstream",
      "rule": "float-equality"
    },
    {
      "category": "concurrency",
      "count": 0,
      "description": "a function body assigning to a *special-looking* global, which is shared mutable state",
