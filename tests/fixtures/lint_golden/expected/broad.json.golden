    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a bounded-sequence call with an explicit :end nil, the default ((find x seq :end nil) is (find x seq))",
      "rule": "redundant-end-nil"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a sequence call with an explicit :from-end nil, the default ((find x seq :from-end nil) is (find x seq))",
      "rule": "redundant-from-end-nil"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a remove/delete/substitute call with an explicit :count nil, the default ((remove x seq :count nil) is (remove x seq))",
      "rule": "redundant-count-nil"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a string= of two same-case-folded operands ((string= (string-downcase a) (string-downcase b)) is (string-equal a b))",
      "rule": "string-case-fold"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a char= of two same-case-folded operands ((char= (char-downcase a) (char-downcase b)) is (char-equal a b))",
      "rule": "char-case-fold"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "nested string case ops where the outer dominates ((string-upcase (string-downcase s)) is (string-upcase s))",
      "rule": "nested-string-case"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a code-char of a char-code, a round-trip that is just the character ((code-char (char-code c)) is c)",
      "rule": "code-char-char-code"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a last call with an explicit count of 1, the default ((last x 1) is (last x))",
      "rule": "last-default-count"
    },
    {
      "category": "suspicious",
      "count": 1,
      "description": "a butlast/nbutlast call with an explicit count of 1, the default ((butlast x 1) is (butlast x))",
