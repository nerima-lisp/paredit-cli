    },
    {
      "category": "concurrency",
      "count": 0,
      "description": "a conditional that tests a place and then assigns to the same place, which another thread can interleave",
      "rule": "check-then-act"
    },
    {
      "category": "security",
      "count": 0,
      "description": "an eval, intern, or read-from-string whose argument is not a literal the source shows",
